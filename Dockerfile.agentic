FROM ghcr.io/av/tools:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev \
    libpq-dev \
    libxml2-dev \
    libxslt1-dev \
    libjpeg-dev \
    zlib1g-dev \
    libfreetype6-dev \
    && rm -rf /var/lib/apt/lists/*

RUN uv pip install --system --break-system-packages --no-cache-dir \
    PyPDF2 \
    python-docx \
    openpyxl \
    Pillow \
    lxml \
    beautifulsoup4 \
    markdownify \
    chardet \
    pandas \
    numpy \
    matplotlib \
    tabulate \
    requests \
    httpx \
    aiohttp \
    sqlalchemy \
    psycopg2-binary \
    pydantic \
    tiktoken
